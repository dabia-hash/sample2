<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trn_department_form" model="ir.ui.view">
        <field name="name">trn.department.form</field>
        <field name="model">trn.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="e.g. CCS"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. College of Computer Studies"/>
                            <field name="course_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Courses" name="courses">
                            <field name="course_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="student_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trn_department_list" model="ir.ui.view">
        <field name="name">trn.department.list</field>
        <field name="model">trn.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="course_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_trn_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">trn.department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a department</p>
            <p>
                Every course belongs to a department, so adding one here makes
                it available when the course list is maintained.
            </p>
        </field>
    </record>
</odoo>
