<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trn_subject_form" model="ir.ui.view">
        <field name="name">trn.subject.form</field>
        <field name="model">trn.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="e.g. IT101"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Programming 1"/>
                            <field name="units"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="offering_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Offerings" name="offerings">
                            <field name="offering_ids" readonly="1">
                                <list>
                                    <field name="school_year"/>
                                    <field name="semester"/>
                                    <field name="faculty_id"/>
                                    <field name="student_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trn_subject_list" model="ir.ui.view">
        <field name="name">trn.subject.list</field>
        <field name="model">trn.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="units"/>
                <field name="department_id"/>
                <field name="offering_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_trn_subject_search" model="ir.ui.view">
        <field name="name">trn.subject.search</field>
        <field name="model">trn.subject</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="code"
                    string="Subject"
                    filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self)]"
                />
                <field name="department_id"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter
                        name="group_by_department"
                        string="Department"
                        context="{'group_by': 'department_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_trn_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">trn.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_trn_subject_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a subject</p>
            <p>
                Subjects are the catalogue. To have students take one, offer it
                in a term from Subject Offerings.
            </p>
        </field>
    </record>
</odoo>
