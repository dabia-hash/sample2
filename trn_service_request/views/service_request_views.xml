<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trn_service_request_form" model="ir.ui.view">
        <field name="name">trn.service.request.form</field>
        <field name="model">trn.service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_assign"
                        string="Assign"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'new'"
                        groups="trn_service_request.group_service_request_officer"
                    />
                    <button
                        name="action_start"
                        string="Start Work"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'assigned'"
                        groups="trn_service_request.group_service_request_officer"
                    />
                    <button
                        name="action_resolve"
                        string="Mark Resolved"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ['assigned', 'in_progress']"
                        groups="trn_service_request.group_service_request_officer"
                    />
                    <button
                        name="action_close"
                        string="Close"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'resolved'"
                        groups="trn_service_request.group_service_request_officer"
                    />
                    <button
                        name="action_open_rating_wizard"
                        string="Rate this service"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'closed' or rating_value"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state in ['closed', 'cancelled']"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="new,assigned,in_progress,resolved,closed"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <label for="title"/>
                        <h2>
                            <field name="title" placeholder="e.g. Cannot log in after password change"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="requester_id"/>
                            <field name="office_id"/>
                            <field name="catalog_id"/>
                            <field name="category_id" readonly="1"/>
                            <field name="priority" widget="priority"/>
                            <field name="priority_code_id" invisible="1"/>
                        </group>
                        <group string="Handling">
                            <field name="team_id"/>
                            <field name="team_member_ids" invisible="1"/>
                            <field
                                name="assigned_user_id"
                                domain="[('id', 'in', team_member_ids)]"
                            />
                            <field name="submitted_date" readonly="1"/>
                            <field
                                name="deadline_date"
                                readonly="1"
                                decoration-danger="is_overdue"
                            />
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field
                                name="description"
                                placeholder="What happened, what you expected, and anything you already tried."
                            />
                            <group name="additional_request_description" invisible="1"/>
                        </page>
                        <page string="Resolution" name="resolution">
                            <field
                                name="resolution"
                                placeholder="What was done to fix it."
                            />
                        </page>
                        <page
                            string="Satisfaction"
                            name="satisfaction"
                            invisible="not rating_value"
                        >
                            <group>
                                <field name="rating_value"/>
                                <field name="rating_comment"/>
                            </group>
                        </page>
                        <page string="Dates" name="dates">
                            <group>
                                <field name="assigned_date"/>
                                <field name="resolved_date"/>
                                <field name="closed_date"/>
                            </group>
                        </page>
                    </notebook>
                    <group name="additional_request_details" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_trn_service_request_list" model="ir.ui.view">
        <field name="name">trn.service.request.list</field>
        <field name="model">trn.service.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="title"/>
                <field name="requester_id"/>
                <field name="office_id"/>
                <field name="catalog_id"/>
                <field name="priority" widget="priority"/>
                <field name="team_id" optional="show"/>
                <field name="assigned_user_id" optional="show"/>
                <field name="deadline_date" optional="show"/>
                <field name="is_overdue" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_trn_service_request_kanban" model="ir.ui.view">
        <field name="name">trn.service.request.kanban</field>
        <field name="model">trn.service.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong><field name="name"/></strong>
                                <div><field name="title"/></div>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="catalog_id"/></div>
                            <div><field name="office_id"/></div>
                            <div t-if="record.is_overdue.raw_value" class="text-danger">
                                Overdue
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <field name="assigned_user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_trn_service_request_search" model="ir.ui.view">
        <field name="name">trn.service.request.search</field>
        <field name="model">trn.service.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="requester_id"/>
                <field name="office_id"/>
                <field name="catalog_id"/>
                <field name="assigned_user_id"/>
                <separator/>
                <filter
                    name="filter_my_requests"
                    string="My Requests"
                    domain="[('requester_id', '=', uid)]"
                />
                <filter
                    name="filter_assigned_to_me"
                    string="Assigned to Me"
                    domain="[('assigned_user_id', '=', uid)]"
                />
                <separator/>
                <filter
                    name="filter_open"
                    string="Open"
                    domain="[('state', 'in', ['new', 'assigned', 'in_progress'])]"
                />
                <filter
                    name="filter_unassigned"
                    string="Unassigned"
                    domain="[('assigned_user_id', '=', False)]"
                />
                <filter
                    name="filter_overdue"
                    string="Overdue"
                    domain="[('is_overdue', '=', True)]"
                />
                <separator/>
                <filter
                    name="filter_submitted_date"
                    string="Submitted"
                    date="submitted_date"
                />
                <group name="group_by">
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_office"
                        string="Office"
                        context="{'group_by': 'office_id'}"
                    />
                    <filter
                        name="group_by_catalog"
                        string="Service"
                        context="{'group_by': 'catalog_id'}"
                    />
                    <filter
                        name="group_by_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                    <filter
                        name="group_by_team"
                        string="Team"
                        context="{'group_by': 'team_id'}"
                    />
                    <filter
                        name="group_by_assigned"
                        string="Assigned To"
                        context="{'group_by': 'assigned_user_id'}"
                    />
                    <filter
                        name="group_by_priority"
                        string="Priority"
                        context="{'group_by': 'priority'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_trn_service_request_pivot" model="ir.ui.view">
        <field name="name">trn.service.request.pivot</field>
        <field name="model">trn.service.request</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="office_id" type="row"/>
                <field name="catalog_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_trn_service_request_graph" model="ir.ui.view">
        <field name="name">trn.service.request.graph</field>
        <field name="model">trn.service.request</field>
        <field name="arch" type="xml">
            <graph sample="1">
                <field name="office_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="action_trn_service_request" model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">trn.service.request</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_trn_service_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise the first service request</p>
            <p>
                Pick the service you need, describe the problem, and IT will pick
                it up. You can follow progress here until it is closed.
            </p>
        </field>
    </record>

    <record id="action_trn_service_request_report" model="ir.actions.act_window">
        <field name="name">Service Request Analysis</field>
        <field name="res_model">trn.service.request</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_trn_service_request_search"/>
    </record>
</odoo>
