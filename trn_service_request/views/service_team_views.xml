<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trn_service_team_form" model="ir.ui.view">
        <field name="name">trn.service.team.form</field>
        <field name="model">trn.service.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Network Team"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. NET"/>
                            <field name="team_lead_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Members">
                        <field name="member_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                    <group string="Email Intake">
                        <field name="alias_name" placeholder="e.g. accounts"/>
                        <field name="alias_domain_id"/>
                        <field name="alias_email" invisible="not alias_email"/>
                        <field
                            name="default_catalog_id"
                            required="alias_name"
                            help="Mail arriving at this address becomes a request for this service."
                        />
                    </group>
                    <group name="additional_team_details" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trn_service_team_list" model="ir.ui.view">
        <field name="name">trn.service.team.list</field>
        <field name="model">trn.service.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="team_lead_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_trn_service_team" model="ir.actions.act_window">
        <field name="name">Service Teams</field>
        <field name="res_model">trn.service.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an IT team</p>
            <p>
                Requests can only be assigned to a member of the handling team,
                so add the staff who work each specialty.
            </p>
        </field>
    </record>
</odoo>
