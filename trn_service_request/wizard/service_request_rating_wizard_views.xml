<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trn_service_request_rating_wizard_form" model="ir.ui.view">
        <field name="name">trn.service.request.rating.wizard.form</field>
        <field name="model">trn.service.request.rating.wizard</field>
        <field name="arch" type="xml">
            <form string="Rate this service">
                <group>
                    <field name="request_id"/>
                    <field name="rating_value"/>
                    <field
                        name="rating_comment"
                        placeholder="Anything the IT team should know?"
                    />
                </group>
                <footer>
                    <button
                        name="action_submit_rating"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
